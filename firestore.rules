rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN = các email này. Thêm admin khác: thêm email vào danh sách, cách nhau bằng dấu phẩy.
    // Admin bắt buộc phải xác nhận email (email_verified) nên không ai đăng ký bằng email admin mà chiếm được quyền.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['lynguyenngoc261@gmail.com', 'nguyenduyforword@gmail.com'];
    }
    function isStaff() {
      return request.auth != null && (isAdmin()
        || (exists(/databases/$(database)/documents/staff/$(request.auth.uid))
            && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true));
    }
    function mine(d) { return d.ownerId == request.auth.uid; }

    // Hồ sơ nhân viên đã được duyệt
    match /staff/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
      // nhân viên chỉ được sửa tên và số điện thoại của chính mình
      allow update: if request.auth != null && request.auth.uid == uid
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']);
    }

    // Tài khoản mới đăng ký, chờ admin duyệt
    match /pending/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'createdAt']);
      allow delete: if isAdmin();
    }

    // Bảng giá (xe, ưu đãi) và cài đặt chung (phí tỉnh...): nhân viên đã được duyệt chỉ xem, chỉ admin được sửa
    match /catalog/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /settings/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // Chỉnh sửa riêng của từng nhân viên (không ảnh hưởng bảng chung): nhân viên chỉ đọc và ghi của mình, admin xem và xử lý tất cả
    match /custom/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.ownerId == request.auth.uid);
      allow create: if isStaff() && id == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (isStaff() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (isStaff() && resource.data.ownerId == request.auth.uid);
    }

    // Khách và báo giá: mỗi nhân viên chỉ thấy của mình, admin thấy tất cả
    match /customers/{id} {
      allow read: if isAdmin() || (isStaff() && mine(resource.data));
      allow create: if isStaff() && mine(request.resource.data);
      allow update: if isAdmin() || (isStaff() && mine(resource.data) && mine(request.resource.data));
      allow delete: if isAdmin() || (isStaff() && mine(resource.data));
    }
    match /quotes/{id} {
      allow read: if isAdmin() || (isStaff() && mine(resource.data));
      allow create: if isStaff() && mine(request.resource.data);
      allow update: if isAdmin() || (isStaff() && mine(resource.data) && mine(request.resource.data));
      allow delete: if isAdmin() || (isStaff() && mine(resource.data));
    }
  }
}
